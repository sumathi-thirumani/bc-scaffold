# Copy to .env and fill in. GitHub Actions supplies these values in CI.

# Required: token with security_events and repo read access
GITHUB_TOKEN=

# Optional branch or tag; defaults to RepositoryContext.ref
SECURITY_REMEDIATION_REF=

# owner/name (set automatically by GitHub Actions)
GITHUB_REPOSITORY=sumathi-thirumani/unified-scheduling

# Comma-separated; leave blank for all supported ecosystems
SECURITY_REMEDIATION_ECOSYSTEMS=npm,pip,nuget

# true or false
SECURITY_REMEDIATION_VERIFICATION_ENABLED=true
SECURITY_REMEDIATION_ADDITIONAL_UPDATES=false
SECURITY_REMEDIATION_ARTIFACT_OUTPUT=true
